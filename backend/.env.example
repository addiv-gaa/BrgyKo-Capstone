# ==============================================================================
# BarangayKo (BrgyKo) Backend Environment Configuration
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Django Secret Key (generate a random 50+ character string for production)
DJANGO_SECRET_KEY=your-secure-random-secret-key-here

# Debug Mode: Set to True for local development, False for production hosting
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated domains/IPs without http/https)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com

# PostgreSQL / PostGIS Database Settings
DB_NAME=brgykodb
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432

# Google Gemini API Key (Required for AI Assistant / Chatbot)
# Get a free key at https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here
